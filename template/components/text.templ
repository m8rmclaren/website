package components

templ InlineGithubLink(text, href string) {
	<a
		class="ml-1 mr-1 inline-flex items-center gap-1 border border-gray-300 rounded px-1 transition-all duration-200 hover:border-gray-500 hover:px-2"
		href={ href }
		rel="noopener"
		target="_blank"
	>
		@GithubIcon("w-3 fill-[#24292F] dark:fill-white")
		<span>{ text }</span>
	</a>
}

templ InlineLink(text, href string, icon templ.Component) {
	<a
		class="ml-1 mr-1 inline-flex items-center gap-1 border border-gray-300 rounded px-1 transition-all duration-200 hover:border-gray-500 hover:px-2"
		href={ href }
		rel="noopener"
		target="_blank"
	>
		@icon
		<span>{ text }</span>
	</a>
}

templ InlineItalics(text string) {
	<span class="italic">{ text }</span>
}

templ InlineBold(text string) {
	<span class="font-medium">{ text }</span>
}
