templ IstioIcon(class string) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		class={ class }
		version="1.1"
		viewBox="0 0 160 240"
	><g id="logo" fill="#466BB0"><polygon id="hull" points="0 210 160 210 60 240"></polygon><polygon id="mainsail" points="0 200 60 190 60 80"></polygon><polygon id="headsail" points="70 190 160 200 70 0"></polygon></g></svg>
}

