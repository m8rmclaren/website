package view

import "github.com/m8rmclaren/website/template/components"

templ Skills() {
	<div class="flex flex-col gap-2">
		<!-- Skills & Open bracket -->
		<h2 class="text-3xl font-bold">Skills <span class="font-normal text-3xl text-[#4876A2] font-mono text-accent-1 leading-none select-none">&#123;</span></h2>
		<div class="flex flex-col pl-4 gap-16">
			@skills()
			@stack()
		</div>
		<!-- Close bracket -->
		<div class="text-3xl text-[#4876A2] font-mono text-accent-1 leading-none select-none">&#125;</div>
	</div>
}

templ skills() {
	<div class="flex flex-col md:flex-row justify-stretch gap-8">
		<div class="flex flex-col gap-4 md:w-96">
			<p>
				I’m a full-stack engineer with hands-on experience across the stack — building backend services, frontend UIs, Kubernetes operators, CI/CD pipelines, and cloud infrastructure using Terraform and Pulumi.
			</p>
			<p>
				I also work across infrastructure and IT layers — managing Linux systems, configuring networking with DNS, layer 4 load balancers, and layer 7 gateways, and implementing OAuth2/OIDC flows. I also have practical experience with PKI and digital certificates.
			</p>
			<p>
				@components.InlineGithubLink("The site you're looking at", "https://github.com/m8rmclaren/website")
				is built with HTML and CSS, served by a Go webserver, deployed to Kubernetes via ArgoCD. Its infrastructure is provisioned with
				@components.InlineGithubLink("Terraform", "https://github.com/m8rmclaren/infra")
				.
			</p>
		</div>
		@software()
	</div>
}

templ software() {
	<div class="flex flex-row md:gap-4 sm:gap-2 justify-between">
		<div class="flex flex-col gap-2">
			<h3 class="h-12 flex items-center font-medium">
				Programming languages
			</h3>
			<div class="flex flex-col gap-2">
				@tool("Go", components.GoIcon("w-8"))
				@tool("Python", components.PythonIcon("w-6"))
				@tool("TypeScript", components.TypescriptIcon("w-5"))
				@tool("C# (.NET)", components.CSharpIcon("w-6"))
				@tool("C", components.CIcon("w-5"))
				@tool("Bash", components.BashIcon("w-6"))
			</div>
		</div>
		<div class="bg-[#4876A2] h-full w-2 rounded-2xl shadow-md transition-opacity duration-300 opacity-100 z-50"></div>
		<div class="flex flex-col gap-2">
			<h3 class="h-12 flex items-center font-medium">
				Infrastructure
			</h3>
			<div class="flex flex-col gap-2">
				@tool("Github Actions", components.GithubActionsIcon("w-6"))
				@tool("Terraform", components.TerraformIcon("w-6"))
				@tool("Kubernetes", components.KubernetesIcon("w-6"))
				@tool("Istio", components.IstioIcon("w-5"))
				@tool("ArgoCD", components.ArgoCDIcon("w-6"))
			</div>
		</div>
		<div class="bg-[#4876A2] h-full w-2 rounded-2xl shadow-md transition-opacity duration-300 opacity-100 z-50"></div>
		<div class="flex flex-col gap-2">
			<h3 class="h-12 flex items-center font-medium">
				Cloud providers
			</h3>
			<div class="flex flex-col gap-2">
				@tool("AWS", components.AWSIcon("w-6"))
				@tool("GCP", components.GCPIcon("w-6"))
				@tool("Azure", components.AzureIcon("w-6"))
			</div>
		</div>
	</div>
}

templ stack() {
	<div class="flex flex-col md:flex-row justify-stretch gap-8">
		<div class="flex flex-col gap-4 md:w-96">
			<p>
				Effective engineering starts with the right tools. I’ve spent years curating a setup that supports fast, focused development by maximizing productivity and minimizing mental overhead.
				@components.InlineGithubLink("dotfiles", "https://github.com/m8rmclaren/dotfiles")
			</p>
		</div>
		<div class="flex flex-row items-center gap-2 flex-wrap">
			@tool("MacOS", components.MacOSIcon("w-6"))
			@tool("Yabai", components.YabaiIcon("w-6"))
			@tool("ITerm2", components.ITerm2Icon("w-6"))
			@tool("Tmux", components.TmuxIcon("w-6"))
			@tool("Neovim", components.NeovimIcon("w-5"))
		</div>
	</div>
}

templ tool(title string, icon templ.Component) {
	<div
		class="inline-flex items-center gap-1 border border-white dark:border-stone-900 rounded px-1 transition-all duration-200 hover:border-gray-500 hover:px-2"
	>
		<div class="min-w-[2rem] flex justify-center">
			@icon
		</div>
		<span class="text-left font-mono">{ title }</span>
	</div>
}
