package view

import "github.com/m8rmclaren/website/template/components"

templ Skills() {
	<div class="flex flex-col gap-2">
		<!-- Skills & Open bracket -->
		<h2 class="text-3xl font-bold">Skills <span class="font-normal text-3xl text-[#4876A2] font-mono text-accent-1 leading-none select-none">&#123;</span></h2>
		<div class="flex flex-row justify-stretch">
			<div class="pl-4">
				<p>
					I'm a full-stack engineer. I build everything from backend services and frontend UIs to Kubernetes operators, CI/CD pipelines, and declarative cloud infrastructure using Terraform and Pulumi. 
				</p>
			</div>
			@software()
		</div>
		<!-- Close bracket -->
		<div class="text-3xl text-[#4876A2] font-mono text-accent-1 leading-none select-none">&#125;</div>
	</div>
}

templ software() {
	<div class="flex flex-col">
		@tool("Go", components.GoIcon("w-8"))
		@tool("C", components.CIcon("w-5"))
		@tool("Terraform", components.TerraformIcon("w-6"))
		@tool("Github Actions", components.GithubActionsIcon("w-6"))
		@tool("Kubernetes", components.KubernetesIcon("w-6"))
		@tool("Python", components.PythonIcon("w-6"))
		@tool("AWS", components.AWSIcon("w-6"))
		@tool("GCP", components.GCPIcon("w-6"))
		@tool("Azure", components.AzureIcon("w-6"))
	</div>
}

templ tool(title string, icon templ.Component) {
	<div
		class="inline-flex items-center gap-1 border border-white dark:border-black rounded px-1 transition-all duration-200 hover:border-gray-500 hover:px-2 w-full"
	>
		<div class="min-w-[2rem] flex justify-center">
			@icon
		</div>
		<span class="text-left font-mono">{ title }</span>
	</div>
}
