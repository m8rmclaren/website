package view

import (
	"context"
	"html"
	"io"
	"regexp"
	"strings"
)

func Text(s string) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		_, err := io.WriteString(w, s) // will NOT escape; if you want escaping, use html/template or a safer writer
		return err
	})
}

templ keyfactorProductOwnerDescription() {
	<p>
		Worked directly with customers to ensure delivery of critical features in Keyfactor’s flagship and ancillary products.
	</p>
	<p>
		Conducted internal and customer interviews to identify and prioritize optimizations that removed major pain points in deploying and scaling integrations with Keyfactor’s core products; follow-up interviews showed measurable improvements in customer deployment speed and reliability.
	</p>
	<p>
		Led incident response when product defects caused customer outages: diagnosed issues, brought the right engineers into the investigation, and advocated for swift fixes and prioritized releases to restore service and maintain customer trust.
	</p>
}

templ keyfactorIntegrationEngineerDescription() {
	<p>
		Implemented and shipped key integrations to platforms & applications such as Azure & Kubernetes. Contributed to open-source projects like SPIFFE SPIRE & Mender Artifact.
	</p>
	<p>
		Streamlined internal documentation procurement processes to enhance consistency and clarity and reduce developer workloads.
	</p>
	<p>
		Designed and implemented developer platform used by more than 20% of Keyfactor staff.
	</p>
}

templ keyfactorIntegrationEngineerInternDescription() {
	<p>
		Conducted research for most popular DevOps tools to determine digital certificate usage.
	</p>
	<p>
		Implemented and shipped integrations targeting cert-manager (K8s), Terraform, Hashicorp Vault
	</p>
}

