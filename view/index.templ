package view

templ Index(name string) {
	<!DOCTYPE html>
	<html>
		<head lang="en">
			<meta charset="UTF-8"/>
			<link rel="icon" href="/favicon.ico"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<!-- SEO -->
			<title>Hayden Roszell - Human Software Engineer</title>
			<meta name="description" content="Computer Scientist motivated by passion."/>
			<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
			<meta name="language" content="English"/>
			<!-- Pre load -->
			<script src="https://unpkg.com/htmx.org@1.9.10" integrity="sha384-D1Kt99CQMDuVetoL1lrYwg5t+9QdHe7NLX/SoJYkXDFfX37iInKRy5xLSi8nO7UC" crossorigin="anonymous"></script>
			<link href="/static/output.css" rel="stylesheet"/>
		</head>
		<body>
			<h1 class="rounded-lg p-4 text-xs italic text-gray-700 text-center">
				Hi, { name } - I hope your day is going well so far!
			</h1>
		</body>
	</html>
}
